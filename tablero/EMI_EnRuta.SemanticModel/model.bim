        ],
        "partitions": [
          {
            "name": "decisiones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // RutaCSV: parámetro de texto con la ruta absoluta de EMI_EnRuta\\datos\\decisiones.csv.",
                "    // Una fila = una decisión (un intento confirmado). Las filas del esquema v1 traen vacías las columnas v2.",
                "    Origen = Csv.Document(File.Contents(RutaCSV), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabeceras = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    Vacias = Table.ReplaceValue(Cabeceras, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Cabeceras)),",
                "    Enteros = {\"cantidad_elegibles\",\"posicion_elegida\",\"servicios_turno_elegido\",\"cumple_objetivo\",\"cumple_r02\",",
                "        \"version_esquema\",\"es_excepcion\",\"cantidad_moviles\",\"coincide_referencia\"},",
                "    Decimales = {\"objetivo_min\",\"previo_despacho_min\",\"min_viaje_recomendado\",\"costo_viaje_recomendado_cop\",",
                "        \"segundos_decision\",\"min_viaje_elegido\",\"factor_trafico\",\"distancia_elegida_km\",\"primera_llegada_estimada_min\",",
                "        \"exceso_min\",\"tarifa_despachador_min_cop\",\"tarifa_movil_km_cop\",\"tarifa_movil_hora_cop\",\"costo_decision_cop\",",
                "        \"costo_viaje_primera_cop\",\"espera_liberacion_min\",\"min_viaje_ambulancia\",\"km_ambulancia\",\"factor_ambulancia\",",
                "        \"tarifa_ambulancia_km_cop\",\"tarifa_ambulancia_hora_cop\",\"llegada_ambulancia_estimada_min\",",
                "        \"costo_viaje_ambulancia_cop\",\"costo_viaje_elegido_cop\",\"costo_total_estimado_cop\",",
                "        \"minuto_solicitud_escenario\",\"transcurrido_al_confirmar_min\",\"espera_elegido_min\",\"llegada_mostrada_min\",",
                "        \"costo_mostrado_cop\",\"km_total_elegido\",\"referencia_primera_llegada_min\",\"referencia_costo_ida_cop\"},",
                "    // fecha_hora_decision conserva su desfase horario como texto ISO; la fecha del escenario es datetime.",
                "    Fechas = {{\"fecha_solicitud_escenario\", type datetime}},",
                "    // Solo se tipan las columnas presentes, para leer también un registro v1.",
                "    Presentes = Table.ColumnNames(Vacias),",
                "    EnterosP = List.Intersect({Enteros, Presentes}),",
                "    DecimalesP = List.Intersect({Decimales, Presentes}),",
                "    Texto = List.Difference(Presentes, List.Combine({EnterosP, DecimalesP, List.Transform(Fechas, each _{0})})),",
                "    Tipos = List.Combine({List.Transform(Texto, each {_, type text}), List.Transform(EnterosP, each {_, Int64.Type}),",
                "        List.Transform(DecimalesP, each {_, type number}), Fechas}),",
                "    // Los CSV usan punto decimal: se convierte con cultura en-US. Código EMI e identificadores quedan como texto.",
                "    Datos = Table.TransformColumnTypes(Vacias, Tipos, \"en-US\"),",
                "    // Las participaciones se expanden en otra consulta: aquí no se suman móviles para no duplicar costos.",
                "    Resultado = Table.RemoveColumns(Datos, List.Intersect({{\"vista_json\", \"participaciones_json\"}, Presentes}))",
                "in",
                "    Resultado"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Decisiones",
            "expression": "DISTINCTCOUNT(decisiones[solicitud_id])",
            "formatString": "0"
          },
          {
            "name": "Asignadas",
            "expression": "COALESCE(CALCULATE([Decisiones], decisiones[estado_decision] = \"asignada\"), 0)",
            "formatString": "0"
          },
          {
            "name": "Pendientes o sin asignar",
            "expression": "COALESCE(CALCULATE([Decisiones], decisiones[estado_decision] IN {\"pendiente\", \"sin_asignar\"}), 0)",
            "formatString": "0"
          },
          {
            "name": "Decisión mediana (s)",
            "expression": "MEDIAN(decisiones[segundos_decision])",
            "formatString": "0.0"
          },
          {
            "name": "Cumple R02 (%)",
            "expression": "DIVIDE(SUM(decisiones[cumple_r02]), COUNT(decisiones[cumple_r02]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Primera llegada mediana (min)",
            "expression": "MEDIAN(decisiones[primera_llegada_estimada_min])",
            "formatString": "0.0"
          },
          {
            "name": "Dentro del objetivo (%)",
            "expression": "DIVIDE(SUM(decisiones[cumple_objetivo]), [Asignadas])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Denominador cumplimiento",
            "expression": "\"Asignadas: \" & FORMAT([Asignadas], \"0\") & \" · Pendientes o sin asignar: \" & FORMAT([Pendientes o sin asignar], \"0\")"
          },
          {
            "name": "Llegada mediana de ambulancia R04 (min)",
            "expression": "CALCULATE(MEDIAN(decisiones[llegada_ambulancia_estimada_min]), NOT ISBLANK(decisiones[ambulancia_preasignada_id]))",
            "formatString": "0.0"
          },
          {
            "name": "Costo medio de ida por decisión (COP)",
            "expression": "AVERAGE(decisiones[costo_viaje_elegido_cop])",
            "formatString": "#,0"
          },
          {
            "name": "Km medio por decisión",
            "expression": "AVERAGE(decisiones[km_total_elegido])",
            "formatString": "0.0"
          },
          {
            "name": "Costo medio de decisión, supuesto (COP)",
            "expression": "AVERAGE(decisiones[costo_decision_cop])",
            "formatString": "#,0"
          },
          {
            "name": "Participaciones",
            "expression": "COUNTROWS(participaciones)",
            "formatString": "0"
          },
          {
            "name": "Costo de ida por móvil (COP)",
            "expression": "SUM(participaciones[costo_ida_cop])",
            "formatString": "#,0"
          },
          {
            "name": "Δ primera llegada vs referencia (min)",
            "expression": "AVERAGEX(FILTER(decisiones, NOT ISBLANK(decisiones[referencia_primera_llegada_min]) && NOT ISBLANK(decisiones[primera_llegada_estimada_min])),\n             decisiones[primera_llegada_estimada_min] - decisiones[referencia_primera_llegada_min])",
            "formatString": "0.0"
          },
          {
            "name": "Δ costo de ida vs referencia (COP)",
            "expression": "AVERAGEX(FILTER(decisiones, NOT ISBLANK(decisiones[referencia_costo_ida_cop]) && NOT ISBLANK(decisiones[costo_viaje_elegido_cop])),\n             decisiones[costo_viaje_elegido_cop] - decisiones[referencia_costo_ida_cop])",
            "formatString": "#,0"
          },
          {
            "name": "Observaciones con referencia",
            "expression": "COUNTROWS(FILTER(decisiones, NOT ISBLANK(decisiones[referencia_costo_ida_cop])))",
            "formatString": "0"
          },
          {
            "name": "Coincide con la referencia (%)",
            "expression": "DIVIDE(SUM(decisiones[coincide_referencia]), COUNT(decisiones[coincide_referencia]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "P90 histórico (min)",
            "expression": "MAX(linea_base[p90_min])",
            "formatString": "0.0"
          },
          {
            "name": "Cumplimiento histórico (%)",
            "expression": "MAX(linea_base[pct_cumple]) / 100",
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
      {
        "name": "participaciones",
        "columns": [
          {
            "name": "solicitud_id",
            "dataType": "string",
            "sourceColumn": "solicitud_id",
            "summarizeBy": "none"
          },
          {
            "name": "id_movil",
            "dataType": "string",
            "sourceColumn": "id_movil",
            "summarizeBy": "none"
          },
          {
            "name": "tipo",
            "dataType": "string",
            "sourceColumn": "tipo",
            "summarizeBy": "none"
          },
          {
            "name": "rol",
            "dataType": "string",
            "sourceColumn": "rol",
            "summarizeBy": "none"
          },
          {
            "name": "zona_origen",
            "dataType": "string",
            "sourceColumn": "zona_origen",
            "summarizeBy": "none"
          },
          {
            "name": "espera_min",
            "dataType": "double",
            "sourceColumn": "espera_min",
            "summarizeBy": "sum"
          },
          {
            "name": "viaje_min",
            "dataType": "double",
            "sourceColumn": "viaje_min",
            "summarizeBy": "sum"
          },
          {
            "name": "llegada_min",
            "dataType": "double",
            "sourceColumn": "llegada_min",
            "summarizeBy": "sum"
          },
          {
            "name": "km",
            "dataType": "double",
            "sourceColumn": "km",
            "summarizeBy": "sum"
          },
          {
            "name": "costo_ida_cop",
            "dataType": "double",
            "sourceColumn": "costo_ida_cop",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "participaciones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Una fila por móvil elegido. R04 aporta dos filas (VMD + ambulancia) a una sola decisión.",
                "    // Se relaciona con decisiones[solicitud_id] (uno a varios). El costo de decisión vive solo en `decisiones`.",
                "    Origen = Csv.Document(File.Contents(RutaCSV), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Cabeceras = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),",
                "    Asignadas = Table.SelectRows(Cabeceras, each [estado_decision] = \"asignada\"),",
                "    ConJson = if List.Contains(Table.ColumnNames(Asignadas), \"participaciones_json\")",
                "        then Asignadas else Table.AddColumn(Asignadas, \"participaciones_json\", each \"\"),",
                "    // Filas v1 sin JSON: se reconstruyen desde las columnas del primer móvil y la ambulancia preasignada.",
                "    Lista = Table.AddColumn(ConJson, \"partes\", each",
                "        if [participaciones_json] <> null and [participaciones_json] <> \"\" then Json.Document([participaciones_json])",
                "        else List.RemoveNulls({",
                "            [id_movil=[movil_elegido_id], tipo=[tipo_movil_elegido], rol=[rol_elegido], zona_origen=[zona_actual_elegido],",
                "             espera_min=\"0\", viaje_min=[min_viaje_elegido], llegada_min=[primera_llegada_estimada_min],",
                "             km=[distancia_elegida_km], costo_ida_cop=[costo_viaje_primera_cop]],",
                "            if [ambulancia_preasignada_id] = \"\" then null else",
                "            [id_movil=[ambulancia_preasignada_id], tipo=null, rol=[rol_ambulancia], zona_origen=[zona_actual_ambulancia],",
                "             espera_min=[espera_liberacion_min], viaje_min=[min_viaje_ambulancia],",
                "             llegada_min=[llegada_ambulancia_estimada_min], km=[km_ambulancia], costo_ida_cop=[costo_viaje_ambulancia_cop]]})),",
                "    Base = Table.SelectColumns(Lista, {\"solicitud_id\", \"partes\"}),",
                "    Expandida = Table.ExpandListColumn(Base, \"partes\"),",
                "    Campos = {\"id_movil\", \"tipo\", \"rol\", \"zona_origen\", \"espera_min\", \"viaje_min\", \"llegada_min\", \"km\", \"costo_ida_cop\"},",
                "    Registros = Table.ExpandRecordColumn(Expandida, \"partes\", Campos, Campos),",
                "    ComoTexto = Table.TransformColumns(Registros, List.Transform({\"espera_min\", \"viaje_min\", \"llegada_min\", \"km\", \"costo_ida_cop\"},",
                "        (c) => {c, each if _ = null or _ = \"\" then null else Text.From(_, \"en-US\")})),",
                "    Tipos = Table.TransformColumnTypes(ComoTexto, {{\"solicitud_id\", type text}, {\"id_movil\", type text}, {\"tipo\", type text},",
                "        {\"rol\", type text}, {\"zona_origen\", type text}, {\"espera_min\", type number}, {\"viaje_min\", type number},",
                "        {\"llegada_min\", type number}, {\"km\", type number}, {\"costo_ida_cop\", type number}}, \"en-US\")",
                "in",
                "    Tipos"
              ]
            }
          }
        ]
      },
